APP_NAME="FootballLab Bot"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bot.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# Forge creates the MySQL database for you; fill these from the Forge site panel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fbl_bot
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database
# Must be larger than the worker --timeout (160) so a slow AI reply isn't picked up twice.
DB_QUEUE_RETRY_AFTER=200

# --- WhatsApp Cloud API ------------------------------------------------------
# 360dialog (recommended: coexistence keeps the WhatsApp Business app working on your phone)
WHATSAPP_PROVIDER=360dialog
# 360dialog: WHATSAPP_TOKEN = your 360dialog API key. WHATSAPP_PHONE_NUMBER_ID / APP_SECRET / VERIFY_TOKEN unused.
# Random 32+ chars. `php artisan whatsapp:set-webhook` registers it with 360dialog.
WHATSAPP_WEBHOOK_SECRET=
# For direct Meta instead: WHATSAPP_PROVIDER=meta and fill the Meta values below.
# Permanent System User token (Business Settings > System users), never a 24h test token.
WHATSAPP_TOKEN=
# The PHONE NUMBER ID of +971 50 374 1554 from WhatsApp Manager > API Setup (not the number).
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > Settings > Basic > App secret. Required: webhooks are rejected without it.
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value as "Verify token" in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_API_BASE=https://graph.facebook.com

# Admins who get Confirm/Reject buttons. Format: 9715XXXXXXXX (no +, no spaces). Same order for names.
ADMIN_NUMBERS=
ADMIN_NAMES="Farouk,Partner"

# Approved template names (create them in WhatsApp Manager, see README).
WHATSAPP_TEMPLATE_LANG=en
TEMPLATE_ADMIN_APPROVAL=booking_approval_request
TEMPLATE_ADMIN_ALERT=admin_alert
TEMPLATE_CLIENT_UPDATE=booking_update
TEMPLATE_WAITLIST_OPENED=waitlist_game_opened

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=700
CLAUDE_HISTORY_LIMIT=24

# --- FootballLab business facts ------------------------------------------------
FBL_TIMEZONE=Asia/Dubai
FBL_PRICE_FROM=50
FBL_VENUES="Dubai Schools Al Barsha|Al Safa Sports Ground, Nad Al Sheba"
FBL_GROUP_LINK=https://chat.whatsapp.com/BIJG7gpzJWIDLD6UsYZPHR
FBL_EXTRA_FACTS=
FBL_DEFAULT_CAPACITY=14
FBL_DEFAULT_PRICE=50
# --- Payments (Ziina) ----------------------------------------------------------
# With a Ziina API token each booking gets its own link for the exact amount and is detected as paid automatically.
ZIINA_API_TOKEN=
# Random 32+ chars. Register with: php artisan ziina:set-webhook
ZIINA_WEBHOOK_SECRET=
ZIINA_TEST_MODE=false
# Extra amount per booking on top of price x players (e.g. 3 for the card fee). 0 = none.
FBL_PAYMENT_FEE=0
# true = Ziina-verified payments confirm the spot without an admin tap.
FBL_AUTO_CONFIRM_PAID=false
# Fallback only, when Ziina isn't configured or is down: a fixed payment link.
FBL_DEFAULT_PAYMENT_LINK=
FBL_PAYMENT_TIMEOUT_MINUTES=120
FBL_HUMAN_TAKEOVER_HOURS=12
FBL_MAX_PLAYERS_PER_BOOKING=6
FBL_BOT_NUMBER=971503741554
# Live list page at APP_URL/games/<this token>. Long random string; empty disables the page.
FBL_PUBLIC_LIST_TOKEN=
# Send admins the paste-ready group list after every confirm/add/remove.
FBL_AUTO_SHARE_LIST=true
